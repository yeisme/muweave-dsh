{
  "name": "@yeisme/dsh-muweave-eikona",
  "version": "0.1.0",
  "description": "MuWeave DSH Eikona plugin: visual information elements gallery, 2/4-up zoom compare, scorecards, master bindings, and controlled handoff",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  }
}
