{
  "name": "muweave-dsh-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "MuWeave DSH creator plugin suite and .muweave/ materialized bundle workspace",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node -e \"require('node:fs').mkdirSync('temp',{recursive:true})\" && NODE_OPTIONS=--localstorage-file=temp/vitest-localstorage.json vitest run --fileParallelism=false",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "test:integration": "node scripts/pack-plugins.mjs && node scripts/run-integration-e2e.mjs",
    "muweave": "node packages/dsh-muweave-core/lib/cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.3.6"
  },
  "license": "MIT"
}
